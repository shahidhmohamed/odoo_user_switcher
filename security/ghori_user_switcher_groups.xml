<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Only members of this group can use the account switcher and the
        no-password "login as" switch. Membership is the security boundary:
        a switcher user can impersonate other users without their password,
        so the group should only contain trusted admins.
    -->
    <record id="module_category_ghori_user_switcher" model="ir.module.category">
        <field name="name">Ghori User Switcher</field>
        <field name="description">Who can use the account switcher navbar shortcut.</field>
        <field name="sequence">62</field>
    </record>

    <record id="group_ghori_user_switcher" model="res.groups">
        <field name="name">User Switcher</field>
        <field name="category_id" ref="module_category_ghori_user_switcher"/>
        <field name="comment">Can use the User Switcher navbar shortcut to sign in as another user. Grant only to trusted users.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
